# App
APP_NAME=my-app
APP_VERSION=v0.1.1

# HTTP
HTTP_HOST=
HTTP_PORT=8080

# GIN
GIN_MODE=release

# Logger
LOGGER_PRETTY_CONSOLE=true
LOGGER_LEVEL=debug

# OTEL
OTEL_ENDPOINT=localhost:4317
OTEL_NAMESPACE=dev
OTEL_INSTANCE_ID=1

# Postgres
POSTGRES_USER=login
POSTGRES_PASSWORD=pass
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_DB_NAME=postgres

# Redis
REDIS_ADDR=redis:6379
TTL=12h

# Kafka
KAFKA_WRITER_ADDR=kafka:9094
KAFKA_CONSUMER_ADDR=kafka:9094

# Rabbit
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672

MAILER_HOST=<host>
MAILER_PORT=587
MAILER_EMAIL=<email>
MAILER_PASSWORD=<password>
MAILER_USE_TLS=true
MAILER_SEND_TIMEOUT=60s
